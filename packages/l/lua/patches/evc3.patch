diff --git a/src/compat/wince/wince_crt.c b/src/compat/wince/wince_crt.c
new file mode 100644
index 0000000..cf40cf9
--- /dev/null
+++ b/src/compat/wince/wince_crt.c
@@ -0,0 +1,262 @@
+/*
+ * src/compat/wince/wince_crt.c
+ * Minimal ANSI C Runtime Compatibility Layer for Windows CE
+ * Targets: HP Jornada 720 (ARM), Casio Cassiopeia A-51 (SH-3), Sigmarion (MIPS)
+ */
+
+#include <windows.h>
+#include "time.h"
+#include "errno.h"
+#include "ctype.h"
+
+/* Global errno instance */
+int _wince_errno = 0;
+
+void abort(void)
+{
+    TerminateProcess(GetCurrentProcess(), 1);
+}
+
+clock_t clock(void)
+{
+    return (clock_t)GetTickCount();
+}
+
+time_t time(time_t *timer)
+{
+    /* Seconds since device boot (monotonic approximation for embedded WinCE) */
+    time_t t = (time_t)(GetTickCount() / 1000);
+    if (timer != NULL) {
+        *timer = t;
+    }
+    return t;
+}
+
+struct tm *localtime(const time_t *timer)
+{
+    static struct tm t;
+    SYSTEMTIME st;
+    (void)timer;
+
+    GetLocalTime(&st);
+    t.tm_sec = st.wSecond;
+    t.tm_min = st.wMinute;
+    t.tm_hour = st.wHour;
+    t.tm_mday = st.wDay;
+    t.tm_mon = st.wMonth - 1;
+    t.tm_year = st.wYear - 1900;
+    t.tm_wday = st.wDayOfWeek;
+    t.tm_yday = 0;
+    t.tm_isdst = 0;
+    return &t;
+}
+
+struct tm *gmtime(const time_t *timer)
+{
+    static struct tm t;
+    SYSTEMTIME st;
+    (void)timer;
+
+    GetSystemTime(&st);
+    t.tm_sec = st.wSecond;
+    t.tm_min = st.wMinute;
+    t.tm_hour = st.wHour;
+    t.tm_mday = st.wDay;
+    t.tm_mon = st.wMonth - 1;
+    t.tm_year = st.wYear - 1900;
+    t.tm_wday = st.wDayOfWeek;
+    t.tm_yday = 0;
+    t.tm_isdst = 0;
+    return &t;
+}
+
+size_t strftime(char *s, size_t max, const char *format, const struct tm *tm)
+{
+    (void)format;
+    (void)tm;
+    if (s != NULL && max > 0) {
+        s[0] = '\0';
+    }
+    return 0;
+}
+
+char *getenv(const char *name)
+{
+    (void)name;
+    return NULL;
+}
+
+int system(const char *cmd)
+{
+    (void)cmd;
+    return -1;
+}
+
+char *strerror(int errnum)
+{
+    (void)errnum;
+    return "Unknown error";
+}
+
+int isspace(int c)
+{
+    return (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v');
+}
+
+int isdigit(int c)
+{
+    return (c >= '0' && c <= '9');
+}
+
+int isalpha(int c)
+{
+    return ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'));
+}
+
+int isalnum(int c)
+{
+    return (isalpha(c) || isdigit(c));
+}
+
+int isprint(int c)
+{
+    return (c >= 0x20 && c <= 0x7E);
+}
+
+int isgraph(int c)
+{
+    return (c > 0x20 && c <= 0x7E);
+}
+
+int iscntrl(int c)
+{
+    return ((c >= 0 && c < 0x20) || c == 0x7F);
+}
+
+int ispunct(int c)
+{
+    return (isprint(c) && !isalnum(c) && c != ' ');
+}
+
+int isupper(int c)
+{
+    return (c >= 'A' && c <= 'Z');
+}
+
+int islower(int c)
+{
+    return (c >= 'a' && c <= 'z');
+}
+
+int isxdigit(int c)
+{
+    return (isdigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'));
+}
+
+char *tmpnam(char *s)
+{
+    static char buf[16] = "\\temp.tmp";
+    if (s != NULL) {
+        strcpy(s, "\\temp.tmp");
+        return s;
+    }
+    return buf;
+}
+
+size_t strspn(const char *s, const char *accept)
+{
+    size_t count = 0;
+    while (*s && strchr(accept, *s)) {
+        count++;
+        s++;
+    }
+    return count;
+}
+
+char *strpbrk(const char *s, const char *accept)
+{
+    while (*s) {
+        if (strchr(accept, *s)) {
+            return (char *)s;
+        }
+        s++;
+    }
+    return NULL;
+}
+
+int strcoll(const char *s1, const char *s2)
+{
+    return strcmp(s1, s2);
+}
+
+int remove(const char *filename)
+{
+    WCHAR wpath[MAX_PATH];
+    MultiByteToWideChar(CP_ACP, 0, filename, -1, wpath, MAX_PATH);
+    return DeleteFileW(wpath) ? 0 : -1;
+}
+
+int rename(const char *oldname, const char *newname)
+{
+    WCHAR wold[MAX_PATH];
+    WCHAR wnew[MAX_PATH];
+    MultiByteToWideChar(CP_ACP, 0, oldname, -1, wold, MAX_PATH);
+    MultiByteToWideChar(CP_ACP, 0, newname, -1, wnew, MAX_PATH);
+    return MoveFileW(wold, wnew) ? 0 : -1;
+}
+
+int setvbuf(FILE *stream, char *buf, int mode, size_t size)
+{
+    (void)stream;
+    (void)buf;
+    (void)mode;
+    (void)size;
+    return 0;
+}
+
+FILE *tmpfile(void)
+{
+    return NULL;
+}
+
+FILE *freopen(const char *path, const char *mode, FILE *stream)
+{
+    (void)path;
+    (void)mode;
+    (void)stream;
+    return NULL;
+}
+
+time_t mktime(struct tm *timeptr)
+{
+    (void)timeptr;
+    return (time_t)(GetTickCount() / 1000);
+}
+
+double strtod(const char *nptr, char **endptr)
+{
+    WCHAR wnptr[256];
+    WCHAR *wend = NULL;
+    double val;
+    int len;
+
+    MultiByteToWideChar(CP_ACP, 0, nptr, -1, wnptr, 256);
+    wnptr[255] = L'\0';
+    val = wcstod(wnptr, &wend);
+    if (endptr != NULL) {
+        if (wend != NULL) {
+            len = (int)(wend - wnptr);
+            *endptr = (char *)(nptr + len);
+        } else {
+            *endptr = (char *)nptr;
+        }
+    }
+    return val;
+}
+
+void wince_report_error(const char *msg)
+{
+    WCHAR wmsg[512];
+    MultiByteToWideChar(CP_ACP, 0, msg, -1, wmsg, 512);
+    MessageBoxW(NULL, wmsg, L"dotstar", MB_OK | MB_ICONERROR);
+}
diff --git a/src/compat/wince/wince_main.c b/src/compat/wince/wince_main.c
new file mode 100644
index 0000000..857c57f
--- /dev/null
+++ b/src/compat/wince/wince_main.c
@@ -0,0 +1,31 @@
+/*
+ * src/compat/wince/wince_main.c
+ * Windows CE WinMain Entry Point Wrapper
+ * Bridges WinMain(HINSTANCE, ...) to standard ANSI C main(argc, argv)
+ */
+
+#include <windows.h>
+
+int main(int argc, char **argv);
+
+int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, LPWSTR lpCmdLine, int nShowCmd)
+{
+    char cmdline_a[MAX_PATH];
+    char *argv[3];
+    int argc = 1;
+    (void)hInstance;
+    (void)hPrevInstance;
+    (void)nShowCmd;
+
+    argv[0] = "dotstar";
+    argv[1] = NULL;
+    argv[2] = NULL;
+
+    if (lpCmdLine != NULL && lpCmdLine[0] != L'\0') {
+        WideCharToMultiByte(CP_ACP, 0, lpCmdLine, -1, cmdline_a, MAX_PATH, NULL, NULL);
+        argv[1] = cmdline_a;
+        argc = 2;
+    }
+
+    return main(argc, argv);
+}
