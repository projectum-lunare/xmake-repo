+/*
+ * src/compat/wince/time.h
+ * ANSI C time.h compatibility for Windows CE
+ */
+#ifndef _WINCE_TIME_H_
+#define _WINCE_TIME_H_
+
+#include <windows.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
